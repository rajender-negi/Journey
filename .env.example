# Copy to .env in the repo root; the server loads it at start.
# Leave a source's variables empty to run it on dummy data (or on an MCP snapshot in data/inbox).
# PJ_MODE=demo forces dummy data for every source.
PJ_MODE=auto
PORT=8787
PJ_WINDOW_DAYS=30
PJ_COLLECT_EVERY_MIN=15

# ServiceNow (product identity + change requests)
SNOW_INSTANCE=
SNOW_TOKEN=
SNOW_USER=
SNOW_PASSWORD=
SNOW_PRODUCT_QUERY=operational_status=1

# GitHub (dedicated variable so a CI-injected GITHUB_TOKEN is never picked up by accident)
PJ_GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# Dynatrace (platform token with storage:events:read, storage:metrics:read, storage:spans:read, storage:system:read)
DT_ENV_URL=https://<tenant>.apps.dynatrace.com
DT_PLATFORM_TOKEN=

# Argo CD and Kubernetes (read-only tokens)
ARGOCD_URL=
ARGOCD_TOKEN=
K8S_API=
K8S_TOKEN=

# AWS Cost Explorer via the AWS CLI credential chain
AWS_COST_ENABLED=false
AWS_PROFILE=
AWS_ENV_TAG_KEY=environment

# Azure Cost Management
AZURE_TOKEN=
AZURE_COST_SCOPE=subscriptions/<id>

# AI layer: anthropic, or openai-compatible for Azure OpenAI or an internal gateway
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_BASE_URL=

# MCP client + LangGraph agent
# Path to the MCP server list (same format as Cursor's .cursor/mcp.json), relative to the repo root.
PJ_MCP_CONFIG=mcp.servers.json
# How many plan -> gather -> verify loops before the agent recommends with what it has
AGENT_MAX_ITERATIONS=2
# hard limit per model call (ms); on expiry the agent step falls back to its rules path
AI_TIMEOUT_MS=45000
# Write-like MCP tools the agent may call after approval, as server:tool (Dynatrace is never writable)
AGENT_WRITE_ALLOWLIST=

# RAG embeddings: any OpenAI-compatible /embeddings endpoint. Empty = local hashing embedder (offline, lower quality)
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMS=1536

# Agent tracing over OTLP/HTTP (OpenTelemetry GenAI attribute names). Dynatrace: https://<env>.live.dynatrace.com/api/v2/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. Authorization=Api-Token%20dt0c01.xxxx (token needs openTelemetryTrace.ingest)
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=product-journey-agent
